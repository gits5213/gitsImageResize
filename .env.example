# Copy to .env for local development. These values are public in the built site.
# Do not put Cloudflare account API tokens, passwords, or other secrets here.

# GitHub Pages project sites need a base path such as /repository-name/
# Leave unset for local development. The deploy workflow sets this automatically.
# VITE_BASE_PATH=/

# Public origin used for canonical URLs, Open Graph tags, and the sitemap.
# No path. Example: https://gits5213.github.io
# The deploy workflow fills this from the repository owner when it is unset.
# VITE_SITE_URL=https://example.com

# Optional Search Console verification token. Letters, numbers, hyphens, and underscores only.
# VITE_GOOGLE_SITE_VERIFICATION=

# Shown on the Contact and legal pages. Leave blank until the owner supplies them.
VITE_SITE_OWNER=
VITE_CONTACT_EMAIL=
VITE_GITHUB_REPO_URL=https://github.com/gits5213/gitsImageResize

# Optional Cloudflare Web Analytics. The beacon token is a public site token, not an API secret.
# The site keeps working when analytics is disabled or the token is missing.
VITE_ANALYTICS_ENABLED=false
VITE_CF_BEACON_TOKEN=
